# ====================================================================
# 🏰 SHAHI STUDIO PRODUCTION ENVIRONMENT VARIABLES
# ====================================================================

# 🌐 Production Frontend Public URL (No trailing slash)
VITE_PUBLIC_APP_URL=https://shahistudio.com

# ⚡ Supabase PostgreSQL & Storage Cloud Engine (https://app.supabase.com)
VITE_SUPABASE_URL=https://owziiqdxbvynrprugvwk.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# 💳 Razorpay Official Payment Gateway (https://dashboard.razorpay.com/app/keys)
# Frontend Public Key ID (Safe to expose in client)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx

# Backend Server Secret Keys (NEVER expose in frontend client code!)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# 🛡️ Backend Server Port & Production CORS Allowed Origins
PORT=5000
ALLOWED_ORIGINS=https://shahistudio.com,https://www.shahistudio.com,http://localhost:3000
JWT_SECRET=SHAHI_ROYAL_SECRET_KEY_2026_VIVAH
