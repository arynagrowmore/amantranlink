{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/templates/(.*)",
      "destination": "/templates/$1"
    },
    {
      "source": "/previews/(.*)",
      "destination": "/previews/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
